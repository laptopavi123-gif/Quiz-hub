<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SSC/Banking - Sentence Improvement Quiz</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --bg-body: #f8fafc;
            --bg-panel: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --correct-bg: #dcfce7;
            --correct-border: #22c55e;
            --correct-text: #166534;
            --wrong-bg: #fee2e2;
            --wrong-border: #ef4444;
            --wrong-text: #991b1b;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
        }

        .quiz-container {
            background: var(--bg-panel);
            max-width: 850px;
            width: 100%;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            margin-top: 20px;
            margin-bottom: 40px;
        }

        .header {
            background: var(--primary);
            color: white;
            padding: 25px;
            text-align: center;
        }

        .header h2 { margin: 0; font-size: 1.5rem; letter-spacing: 0.5px; }

        .progress-container {
            background: #e0e7ff;
            height: 8px;
            width: 100%;
        }

        .progress-bar {
            height: 100%;
            background: #3b82f6;
            width: 0%;
            transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* --- Question View Styles --- */
        .question-body { padding: 40px; min-height: 400px; }

        .question-meta {
            display: flex;
            justify-content: space-between;
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 20px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .question-text {
            font-size: 1.2rem;
            font-weight: 600;
            line-height: 1.6;
            margin-bottom: 30px;
            color: #1e293b;
        }

        .question-text u {
            text-decoration-color: var(--primary);
            text-decoration-thickness: 3px;
            padding-bottom: 2px;
        }

        .options-list { display: flex; flex-direction: column; gap: 14px; }

        .option-btn {
            background: var(--bg-panel);
            border: 2px solid var(--border-color);
            border-radius: 10px;
            padding: 16px 22px;
            font-size: 1.05rem;
            text-align: left;
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'Inter', sans-serif;
            color: var(--text-main);
            font-weight: 500;
        }

        .option-btn:hover:not(:disabled) {
            background: #f8fafc;
            border-color: #cbd5e1;
            transform: translateY(-1px);
        }

        .option-btn:disabled { cursor: default; }

        .option-btn.correct {
            background-color: var(--correct-bg);
            border-color: var(--correct-border);
            color: var(--correct-text);
            font-weight: 600;
        }

        .option-btn.wrong {
            background-color: var(--wrong-bg);
            border-color: var(--wrong-border);
            color: var(--wrong-text);
        }

        .explanation {
            margin-top: 30px;
            background: #f8fafc;
            border-left: 5px solid var(--primary);
            padding: 20px;
            border-radius: 6px;
            font-size: 0.95rem;
            line-height: 1.6;
            display: none;
            animation: fadeIn 0.4s ease;
            color: #334155;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        }

        .explanation strong { color: var(--primary); }

        .footer-nav {
            padding: 20px 40px;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            background: #f8fafc;
        }

        .nav-btn {
            padding: 14px 28px;
            border: none;
            border-radius: 8px;
            background: var(--border-color);
            color: var(--text-main);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 1rem;
        }

        .nav-btn:hover:not(:disabled) { background: #cbd5e1; }
        .nav-btn.primary-btn { background: var(--primary); color: white; }
        .nav-btn.primary-btn:hover:not(:disabled) { background: var(--primary-hover); }
        .nav-btn:disabled { opacity: 0.4; cursor: not-allowed; }

        /* --- Final Result Dashboard Styles --- */
        .result-body {
            display: none;
            padding: 40px;
            background: #f8fafc;
        }

        .dashboard-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .dashboard-header h3 {
            font-size: 2rem;
            color: var(--text-main);
            margin: 0 0 10px 0;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: var(--bg-panel);
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
            border: 1px solid var(--border-color);
        }

        .stat-value {
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .stat-label {
            font-size: 0.85rem;
            text-transform: uppercase;
            color: var(--text-muted);
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .val-total { color: var(--primary); }
        .val-correct { color: #16a34a; }
        .val-wrong { color: #dc2626; }
        .val-acc { color: #d97706; }

        .review-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .review-card {
            background: var(--bg-panel);
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            border: 1px solid var(--border-color);
            position: relative;
            overflow: hidden;
        }

        .review-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 6px;
        }

        .review-card.is-correct::before { background: #22c55e; }
        .review-card.is-wrong::before { background: #ef4444; }
        .review-card.is-skipped::before { background: #94a3b8; }

        .r-question {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 15px;
            color: var(--text-main);
        }

        .r-answer-block {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 15px;
        }

        .r-row {
            display: flex;
            align-items: center;
            font-size: 0.95rem;
            font-weight: 500;
        }

        .icon { margin-right: 8px; font-size: 1.1rem; }

        .r-explanation {
            background: #f1f5f9;
            padding: 15px;
            border-radius: 8px;
            font-size: 0.9rem;
            color: #334155;
            line-height: 1.6;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @media (max-width: 768px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .question-body, .result-body { padding: 25px; }
        }
    </style>
</head>
<body>

<div class="quiz-container">
    <div class="header">
        <h2>Sentence Improvement Quiz</h2>
    </div>
    
    <div class="progress-container">
        <div class="progress-bar" id="progressBar"></div>
    </div>

    <!-- Interface for Answering Questions -->
    <div class="question-body" id="questionBody">
        <div class="question-meta">
            <span id="questionCount">Question 1 of 33</span>
            <span>SSC / Bank Pattern</span>
        </div>
        
        <div class="question-text" id="questionText"></div>
        <div class="options-list" id="optionsContainer"></div>
        <div class="explanation" id="explanationBox"></div>
    </div>

    <div class="footer-nav" id="footerNav">
        <button class="nav-btn" id="prevBtn" onclick="prevQuestion()" disabled>Previous</button>
        <button class="nav-btn primary-btn" id="nextBtn" onclick="nextQuestion()">Next</button>
    </div>

    <!-- Interface for Final Results -->
    <div class="result-body" id="resultBody">
        <div class="dashboard-header">
            <h3>Performance Dashboard</h3>
            <p style="color: var(--text-muted);">Review your answers and explanations below.</p>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value val-total" id="statTotal">0</div>
                <div class="stat-label">Total Questions</div>
            </div>
            <div class="stat-card">
                <div class="stat-value val-correct" id="statCorrect">0</div>
                <div class="stat-label">Correct Answers</div>
            </div>
            <div class="stat-card">
                <div class="stat-value val-wrong" id="statWrong">0</div>
                <div class="stat-label">Incorrect Answers</div>
            </div>
            <div class="stat-card">
                <div class="stat-value val-acc" id="statAcc">0%</div>
                <div class="stat-label">Accuracy</div>
            </div>
        </div>

        <div class="review-list" id="reviewList">
            <!-- Review cards injected here via JS -->
        </div>

        <div style="text-align: center; margin-top: 40px;">
            <button class="nav-btn primary-btn" onclick="location.reload()" style="padding: 16px 40px; font-size: 1.1rem;">Restart Practice</button>
        </div>
    </div>
</div>

<script>
    const quizData = [
        {
            q: "The accused was ordered to be <u>hung to death</u>.",
            options: { a: "hung till death", b: "hanged to death", c: "hanged till death", d: "No correction required" },
            ans: "c",
            expl: "<strong>(c) hanged till death:</strong> The correct verb for execution is 'hanged', and the legal/idiomatic phrase is 'hanged till death'."
        },
        {
            q: "It is sheer folly to believe that you can improve the situation by <u>doing away people</u>.",
            options: { a: "doing it to", b: "doing away with", c: "doing with", d: "No improvement" },
            ans: "b",
            expl: "<strong>(b) doing away with:</strong> The correct phrasal verb meaning to abolish, eliminate, or kill is 'do away with'."
        },
        {
            q: "Would you mind <u>help</u> me with these questions?",
            options: { a: "to help", b: "of helping", c: "helping", d: "No improvement" },
            ans: "c",
            expl: "<strong>(c) helping:</strong> The verb 'mind' in this context must be followed by a gerund ('helping')."
        },
        {
            q: "In fact, if it hadn't been for his <u>invaluable</u> advice on so many occasions I wouldn't have achieved anything in life.",
            options: { a: "remarkable advice", b: "valuable advices", c: "priceless suggestions", d: "No improvement" },
            ans: "d",
            expl: "<strong>(d) No improvement:</strong> 'Invaluable advice' is grammatically and contextually correct. 'Advice' is an uncountable noun."
        },
        {
            q: "He hesitated <u>to accept</u> the post as he did not think that the salary was enough for him to sustain his family.",
            options: { a: "accepting", b: "to accepting", c: "in accepting", d: "while accepting", e: "No correction required" },
            ans: "e",
            expl: "<strong>(e) No correction required:</strong> 'Hesitate to do something' is standard English."
        },
        {
            q: "By temperament the <u>English</u> are reserved, so they prefer to live in solitary houses.",
            options: { a: "English", b: "English people", c: "some English", d: "No improvement" },
            ans: "d",
            expl: "<strong>(d) No improvement:</strong> The definite article 'the' followed by 'English' correctly refers to the people of England collectively."
        },
        {
            q: "My father agreed <u>with my going</u> alone for the examination.",
            options: { a: "I go alone", b: "to my going alone", c: "that I go alone", d: "No improvement" },
            ans: "b",
            expl: "<strong>(b) to my going alone:</strong> You agree 'with' a person, but you agree 'to' a proposal, plan, or action."
        },
        {
            q: "As they met again at 9 p.m. he said, \"Good <u>night</u>, very pleased to see you again\".",
            options: { a: "Good day", b: "Good evening", c: "Good bye", d: "No improvement" },
            ans: "b",
            expl: "<strong>(b) Good evening:</strong> 'Good night' is used as a farewell. When meeting someone, even late, 'Good evening' is appropriate."
        },
        {
            q: "The question is, <u>how</u> was the motive of the robber in this particular case?",
            options: { a: "what was", b: "where was", c: "when was", d: "who was", e: "No correction required" },
            ans: "a",
            expl: "<strong>(a) what was:</strong> A motive is a thing or reason, which corresponds to the question word 'what'."
        },
        {
            q: "Mala <u>was hurried</u> to reach the meeting when she slipped and fell down.",
            options: { a: "is hurried", b: "was being hurried", c: "was hurrying", d: "No correction required" },
            ans: "c",
            expl: "<strong>(c) was hurrying:</strong> The action was actively ongoing in the past when the interruption (slipped and fell) occurred, requiring the past continuous tense."
        },
        {
            q: "He should move on to the next point, and not <u>harp one string only</u>.",
            options: { a: "harp only one string", b: "harp on string only", c: "harp upon one string only", d: "No improvement" },
            ans: "c",
            expl: "<strong>(c) harp upon one string only:</strong> The correct idiom meaning to talk about a single subject repeatedly is to 'harp on' or 'harp upon' one string."
        },
        {
            q: "The dog eats its food <u>in</u> a plate.",
            options: { a: "off", b: "from", c: "with", d: "No improvement" },
            ans: "b",
            expl: "<strong>(b) from:</strong> Animals generally eat 'from' or 'out of' a plate or bowl."
        },
        {
            q: "The parents became extremely <u>troubled</u> when their son did not return by midnight.",
            options: { a: "anxious", b: "depressed", c: "sad", d: "No improvement" },
            ans: "a",
            expl: "<strong>(a) anxious:</strong> Waiting for a child late at night causes anxiety and worry, making 'anxious' the most precise word choice."
        },
        {
            q: "He plans <u>to hurriedly complete</u> this work.",
            options: { a: "to complete hurriedly this work", b: "to complete this work hurriedly", c: "to complete this work in a hurry", d: "No correction required" },
            ans: "b",
            expl: "<strong>(b) to complete this work hurriedly:</strong> Placing the adverb 'hurriedly' at the end of the phrase avoids awkwardly splitting the infinitive ('to complete')."
        },
        {
            q: "What <u>were you doing</u> ever since I last saw you?",
            options: { a: "did you do", b: "are you doing", c: "have you been doing", d: "No improvement" },
            ans: "c",
            expl: "<strong>(c) have you been doing:</strong> 'Ever since' indicates an action that started in the past and continues to the present, requiring the present perfect continuous tense."
        },
        {
            q: "Seeing them all at one place, we realised that something drastic <u>have</u> to be done.",
            options: { a: "was to be done", b: "had to be done", c: "will have to be done", d: "No improvement" },
            ans: "b",
            expl: "<strong>(b) had to be done:</strong> The main verb 'realised' is in the past tense, so the subordinate clause must also be in the past tense ('had to be')."
        },
        {
            q: "I was waiting until everybody <u>will have left</u> the meeting place.",
            options: { a: "until everybody had left", b: "until everybody left", c: "until everybody would leave", d: "No improvement" },
            ans: "a",
            expl: "<strong>(a) until everybody had left:</strong> To show that the waiting continued up to the point when another action in the past was fully completed, the past perfect tense is used."
        },
        {
            q: "Are you <u>more cleverer than us</u>?",
            options: { a: "cleverer to us", b: "more cleverer to us", c: "cleverer than us", d: "No improvement" },
            ans: "c",
            expl: "<strong>(c) cleverer than us:</strong> 'More cleverer' is a double comparative error. The comparative form of 'clever' is 'cleverer', followed by 'than'."
        },
        {
            q: "When she <u>takes her exam</u> she will have a holiday.",
            options: { a: "has taken her exam", b: "took her exam", c: "had taken her exam", d: "No improvement" },
            ans: "a",
            expl: "<strong>(a) has taken her exam:</strong> To indicate that a future action (holiday) will happen only after another action is fully completed, the present perfect is used in the time clause."
        },
        {
            q: "Millions of people in our country <u>are deprived</u> of two square meals since independence.",
            options: { a: "are being deprived problem", b: "have been deprived", c: "has been deprived", d: "No improvement" },
            ans: "b",
            expl: "<strong>(b) have been deprived:</strong> The phrase 'since independence' refers to a duration from the past to the present, requiring the present perfect tense."
        },
        {
            q: "<u>In quick time</u> he got attached to a renowned leader and politician.",
            options: { a: "In enough time", b: "In brief time", c: "In no time", d: "On time only", e: "No correction required" },
            ans: "c",
            expl: "<strong>(c) In no time:</strong> The correct English idiom meaning 'very quickly' or 'almost instantly' is 'in no time'."
        },
        {
            q: "Your statement that you were <u>thorough</u> ignorant of the consequences cannot trusted.",
            options: { a: "thoroughly in ignorance", b: "thoroughly ignorance", c: "thorough of ignorance", d: "thoroughly ignorant", e: "No correction required" },
            ans: "d",
            expl: "<strong>(d) thoroughly ignorant:</strong> An adverb ('thoroughly') is required to modify the adjective 'ignorant'."
        },
        {
            q: "There is <u>rumour</u> that a great leader has been assassinated.",
            options: { a: "is the rumour", b: "is rumours", c: "is a rumour", d: "No improvement" },
            ans: "c",
            expl: "<strong>(c) is a rumour:</strong> 'Rumour' in this specific singular context requires the indefinite article 'a'."
        },
        {
            q: "<u>Asking me why was I absent, I was punished by the Headmaster.</u>",
            options: { a: "why was I absent, was I punished by the Headmaster", b: "why I was absent, was I punished by the Headmaster", c: "why I was absent, the Headmaster punished me", d: "No improvement" },
            ans: "c",
            expl: "<strong>(c) why I was absent, the Headmaster punished me:</strong> This corrects the dangling participle (the Headmaster was the one doing the asking) and fixes the indirect question order (subject + verb)."
        },
        {
            q: "Madan will not be <u>at home</u> until eight o'clock.",
            options: { a: "in home", b: "to home", c: "home", d: "No improvement" },
            ans: "d",
            expl: "<strong>(d) No improvement:</strong> The prepositional phrase 'at home' is idiomatically and grammatically correct."
        },
        {
            q: "People are generally found <u>absorbing</u> in the activity which they like most.",
            options: { a: "absorb", b: "absorbed", c: "observe", d: "observing" },
            ans: "b",
            expl: "<strong>(b) absorbed:</strong> The past participle 'absorbed' acts as an adjective here to describe the state of being deeply involved in something."
        },
        {
            q: "<u>Had you been told</u> me about your problem, I would have helped you.",
            options: { a: "Had you told", b: "Had you have told", c: "If you have told", d: "If you would have told", e: "No correction required" },
            ans: "a",
            expl: "<strong>(a) Had you told:</strong> The active voice ('had you told') is required because 'you' are the one doing the telling. The original is incorrectly in the passive voice."
        },
        {
            q: "I am quite hopeful of <u>securing</u> very high marks in the examination.",
            options: { a: "to secure", b: "to having secured", c: "of having secured", d: "No improvement" },
            ans: "d",
            expl: "<strong>(d) No improvement:</strong> 'Hopeful' is correctly followed by the preposition 'of' and a gerund ('securing')."
        },
        {
            q: "In the past, services of backward communities and weaker sections of society were used without payment of <u>some kind</u>.",
            options: { a: "payment or kind", b: "payment of a kind", c: "payment of any kind", d: "No improvement" },
            ans: "c",
            expl: "<strong>(c) payment of any kind:</strong> In a negative context ('without'), the word 'any' is used instead of 'some'."
        },
        {
            q: "Nothing but books and magazines <u>pleases</u> her.",
            options: { a: "were pleasing", b: "please", c: "are pleasing", d: "No improvement" },
            ans: "d",
            expl: "<strong>(d) No improvement:</strong> 'Nothing' is the singular subject of the sentence, so the singular verb 'pleases' is correct."
        },
        {
            q: "Why did you not <u>spoken</u> to me earlier?",
            options: { a: "did you not spoke", b: "you did not speak", c: "did you not speak", d: "were you not spoken" },
            ans: "c",
            expl: "<strong>(c) did you not speak:</strong> The auxiliary verb 'did' must always be followed by the base form of the verb ('speak')."
        },
        {
            q: "The contractor did not keep his promise that the work <u>will</u> be finished before the end of the week.",
            options: { a: "shall", b: "would", c: "could", d: "No improvement" },
            ans: "b",
            expl: "<strong>(b) would:</strong> Because the main clause is in the past tense ('did not keep'), 'will' must be backshifted to its past equivalent, 'would'."
        },
        {
            q: "There is no <u>absolute worry</u> even if your son refuses to marry her.",
            options: { a: "no absolutely worry", b: "absolutely no worry", c: "absolutely not worrying", d: "No improvement" },
            ans: "b",
            expl: "<strong>(b) absolutely no worry:</strong> The adverb 'absolutely' correctly modifies the determiner 'no'."
        },
        {
            q: "He found it difficult to <u>cope along with</u> his work.",
            options: { a: "to cope also with his work", b: "to cope with his work", c: "to cope up with his work", d: "to cope around his work" },
            ans: "b",
            expl: "<strong>(b) to cope with his work:</strong> The correct phrasal verb meaning to deal effectively with something difficult is 'cope with'. Adding 'along' or 'up' is incorrect."
        }
    ];

    let currentQuestionIndex = 0;
    const userAnswers = new Array(quizData.length).fill(null);
    
    const qBody = document.getElementById('questionBody');
    const footerNav = document.getElementById('footerNav');
    const resultBody = document.getElementById('resultBody');
    const qText = document.getElementById('questionText');
    const optsContainer = document.getElementById('optionsContainer');
    const explBox = document.getElementById('explanationBox');
    const progBar = document.getElementById('progressBar');
    const qCount = document.getElementById('questionCount');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');

    function loadQuestion(index) {
        const qData = quizData[index];
        
        qCount.innerText = `Question ${index + 1} of ${quizData.length}`;
        progBar.style.width = `${((index + 1) / quizData.length) * 100}%`;
        
        qText.innerHTML = `${index + 1}. ${qData.q}`;
        optsContainer.innerHTML = '';
        explBox.style.display = 'none';
        
        for (const [key, value] of Object.entries(qData.options)) {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.innerHTML = `(${key}) ${value}`;
            
            if (userAnswers[index]) {
                btn.disabled = true;
                if (key === qData.ans) {
                    btn.classList.add('correct');
                } else if (key === userAnswers[index] && key !== qData.ans) {
                    btn.classList.add('wrong');
                }
            } else {
                btn.onclick = () => selectAnswer(key, btn);
            }
            optsContainer.appendChild(btn);
        }

        if (userAnswers[index]) {
            explBox.innerHTML = qData.expl;
            explBox.style.display = 'block';
        }

        prevBtn.disabled = index === 0;
        nextBtn.innerText = index === quizData.length - 1 ? 'Finish & View Results' : 'Next';
    }

    function selectAnswer(selectedKey, btnElement) {
        const qData = quizData[currentQuestionIndex];
        userAnswers[currentQuestionIndex] = selectedKey;
        
        const allBtns = optsContainer.querySelectorAll('.option-btn');
        allBtns.forEach(btn => {
            btn.disabled = true;
            const btnKey = btn.innerText.match(/\((.)\)/)[1];
            if (btnKey === qData.ans) btn.classList.add('correct');
        });

        if (selectedKey !== qData.ans) btnElement.classList.add('wrong');

        explBox.innerHTML = qData.expl;
        explBox.style.display = 'block';
        
        setTimeout(() => {
            footerNav.scrollIntoView({ behavior: 'smooth', block: 'end' });
        }, 150);
    }

    function nextQuestion() {
        if (currentQuestionIndex < quizData.length - 1) {
            currentQuestionIndex++;
            loadQuestion(currentQuestionIndex);
        } else {
            showFinalResults();
        }
    }

    function prevQuestion() {
        if (currentQuestionIndex > 0) {
            currentQuestionIndex--;
            loadQuestion(currentQuestionIndex);
        }
    }

    function showFinalResults() {
        qBody.style.display = 'none';
        footerNav.style.display = 'none';
        resultBody.style.display = 'block';

        let correct = 0;
        let wrong = 0;
        let skipped = 0;
        let reviewHTML = '';

        quizData.forEach((q, idx) => {
            const userAns = userAnswers[idx];
            let isCorrect = false;
            let cardClass = '';
            let userIcon = '';
            
            if (!userAns) {
                skipped++;
                cardClass = 'is-skipped';
                userIcon = '<span class="icon" style="color:#94a3b8;">➖</span>';
            } else if (userAns === q.ans) {
                correct++;
                isCorrect = true;
                cardClass = 'is-correct';
                userIcon = '<span class="icon" style="color:#22c55e;">✅</span>';
            } else {
                wrong++;
                cardClass = 'is-wrong';
                userIcon = '<span class="icon" style="color:#ef4444;">❌</span>';
            }

            reviewHTML += `
                <div class="review-card ${cardClass}">
                    <div class="r-question">Q${idx + 1}. ${q.q}</div>
                    <div class="r-answer-block">
                        <div class="r-row ${isCorrect ? 'text-correct' : (userAns ? 'text-wrong' : 'text-muted')}">
                            ${userIcon} Your Answer: ${userAns ? `(${userAns}) ${q.options[userAns]}` : 'Skipped'}
                        </div>
                        ${!isCorrect ? `
                        <div class="r-row text-correct">
                            <span class="icon">🎯</span> Correct Answer: (${q.ans}) ${q.options[q.ans]}
                        </div>` : ''}
                    </div>
                    <div class="r-explanation">${q.expl}</div>
                </div>
            `;
        });

        const total = quizData.length;
        const accuracy = total > 0 ? Math.round((correct / total) * 100) : 0;

        document.getElementById('statTotal').innerText = total;
        document.getElementById('statCorrect').innerText = correct;
        document.getElementById('statWrong').innerText = wrong;
        document.getElementById('statAcc').innerText = `${accuracy}%`;
        
        document.getElementById('reviewList').innerHTML = reviewHTML;
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Initialize Quiz
    loadQuestion(0);
</script>

</body>
</html>
